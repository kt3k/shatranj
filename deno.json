{
  "nodeModulesDir": "auto",
  "tasks": {
    "build": "deno run -A scripts/build.ts",
    "dev": "deno run -A scripts/build.ts --watch --serve",
    "test": "deno test src/",
    "check": "deno check src/ scripts/ && deno lint && deno fmt --check"
  },
  "imports": {
    "@fontsource/inter": "npm:@fontsource/inter@^5.3.0",
    "@fontsource/marcellus": "npm:@fontsource/marcellus@^5.3.0",
    "@fontsource/noto-sans-coptic": "npm:@fontsource/noto-sans-coptic@^5.3.0",
    "@fontsource/reem-kufi": "npm:@fontsource/reem-kufi@^5.3.0",
    "@fontsource/vazirmatn": "npm:@fontsource/vazirmatn@^5.3.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http": "jsr:@std/http@^1",
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.3.4",
    "basecoat-css": "npm:basecoat-css@^1.1.0",
    "gawa": "https://raw.githubusercontent.com/kt3k/gawa/b1c2d6a344b5bb537b0816792b998479b25558d9/web/mod.ts",
    "tailwindcss": "npm:tailwindcss@^4.3.4"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns",
      "deno.worker"
    ]
  },
  "fmt": {
    "exclude": [
      "dist/",
      "app/android/.gawa/",
      "app/android/.gradle/",
      "app/android/build/",
      "app/android/app/build/"
    ]
  },
  "lint": {
    "exclude": [
      "dist/",
      "app/android/.gawa/",
      "app/android/.gradle/",
      "app/android/build/",
      "app/android/app/build/"
    ]
  }
}
