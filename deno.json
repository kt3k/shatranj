{
  "nodeModulesDir": "auto",
  "tasks": {
    "build": "deno run -A scripts/build.ts",
    "dev": "deno run -A scripts/build.ts --watch --serve",
    "test": "deno test src/",
    "check": "deno check src/ scripts/ && deno lint && deno fmt --check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http": "jsr:@std/http@^1",
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.3.4",
    "basecoat-css": "npm:basecoat-css@^1.1.0",
    "tailwindcss": "npm:tailwindcss@^4.3.4"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns", "deno.worker"]
  },
  "fmt": { "exclude": ["dist/"] },
  "lint": { "exclude": ["dist/"] }
}
